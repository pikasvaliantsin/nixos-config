{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "nixos",
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "└ └󰓡",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "blue",
      "text": ". /etc/os-release; printf '%s' \"$PRETTY_NAME\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "blue",
      "text": "nixos-version"
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "blue",
      "text": "printf '%s' 'nixos-unstable'"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├󰏖",
      "keyColor": "blue",
      "text": "nix-store -q --requisites /run/current-system 2>/dev/null | wc -l"
    },
    {
      "type": "command",
      "key": "│ ├󰉼",
      "keyColor": "blue",
      "text": "basename \"$(readlink -f \"$HOME/.local/state/theme/current\" 2>/dev/null)\""
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "blue",
      "text": "theme=$(jq -r .name \"$HOME/.local/state/theme/current/palette.json\" 2>/dev/null || basename \"$(readlink -f \"$HOME/.local/state/theme/current\" 2>/dev/null)\"); printf '%s \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●' \"$theme\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "created=$(stat -c %W / 2>/dev/null || echo 0); [ \"$created\" -gt 0 ] || created=$(stat -c %W /etc/machine-id 2>/dev/null || echo 0); [ \"$created\" -gt 0 ] || created=$(stat -c %Y /nix 2>/dev/null || echo 0); now=$(date +%s); if [ \"$created\" -gt 0 ]; then days=$(( (now - created) / 86400 )); else days=0; fi; printf '%s days' \"$days\""
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": " Generation",
      "keyColor": "magenta",
      "text": "link=$(readlink /nix/var/nix/profiles/system 2>/dev/null); gen=$(echo \"$link\" | sed -E 's/^system-([0-9]+)-link$/\\1/'); gen=${gen:-?}; created=$(stat -c %W /nix/var/nix/profiles/system 2>/dev/null || echo 0); [ \"$created\" -gt 0 ] || created=$(stat -c %Y /nix/var/nix/profiles/system 2>/dev/null || echo 0); now=$(date +%s); if [ \"$created\" -gt 0 ]; then days=$(( (now - created) / 86400 )); else days=0; fi; printf 'generation %s · updated %s days ago' \"$gen\" \"$days\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
