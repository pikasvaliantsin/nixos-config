+def _edge_cache_path(text: str) -> Path:
+    key = hashlib.sha256(f"{EDGE_VOICE}\0{EDGE_RATE}\0{text}".encode()).hexdigest()
+    return EDGE_CACHE_DIR / f"{key}.mp3"
+
+
+def _edge_generate(text: str, dest: Path, timeout: float = 6.0,
+                   attempts: int = 2) -> None:
+    last = None
+    for attempt in range(attempts):
+        dest.unlink(missing_ok=True)
+        try:
+            subprocess.run(
+                [EDGE_BIN, "-v", EDGE_VOICE, "--rate", EDGE_RATE,
+                 "-t", text, "--write-media", str(dest), "--no-progress"],
+                check=True, capture_output=True, timeout=timeout,
+            )
+            if dest.exists() and dest.stat().st_size:
+                return
+            last = RuntimeError("áudio vazio")
+        except Exception as e:
+            last = e
+        if attempt + 1 < attempts:
+            time.sleep(0.25 * (attempt + 1))
+    raise last or RuntimeError("edge tts falhou")
+
+
+def _edge_warm(text: str) -> None:
+    """Gera e guarda uma frase fixa para o primeiro "hey jarvis" não esperar."""
+    cached = _edge_cache_path(text)
+    if cached.exists() and cached.stat().st_size:
+        return
+    tmp = None
+    try:
+        EDGE_CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
+        tmp = EDGE_CACHE_DIR / f".{cached.stem}.{os.getpid()}-{threading.get_ident()}.tmp"
+        _edge_generate(text, tmp, timeout=15.0, attempts=3)
+        tmp.replace(cached)
+    except Exception as e:
