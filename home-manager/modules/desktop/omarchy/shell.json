{
  "version": 1,
  "keyboard": {
    "showCapsOsd": false,
    "showLayoutOsd": false
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.indicators",
          "items": [
            "PasswordlessSudo",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        }
      ],
      "centerBegin": [
        {
          "id": "local.cava"
        },
        {
          "id": "omarchy.media"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.tray",
          "pinned": [],
          "hidden": [
            "udiskie",
            "dank-calendar"
          ]
        },
        {
          "id": "local.notifications"
        },
        {
          "id": "local.opencode"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    }
  },
  "disabledPlugins": [
    "omarchy.agents",
    "omarchy.battery",
    "omarchy.background",
    "omarchy.dev-gallery",
    "omarchy.disk-speedtest",
    "omarchy.dock",
    "omarchy.dropbox",
    "omarchy.elsewhen",
    "omarchy.emojis",
    "omarchy.idle",
    "omarchy.image-picker",
    "omarchy.lock",
    "omarchy.nightlight",
    "omarchy.notifications",
    "omarchy.polkit",
    "omarchy.reminders",
    "omarchy.tailscale",
    "omarchy.wifiqr"
  ],
  "plugins": []
}
