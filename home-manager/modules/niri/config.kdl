// Niri: основной конфиг. Больше не зависит от dux-shell/DMS.
// Тема (цвета) вынесена в theme.kdl, который переключает `theme-set`.

include optional=false "binds.kdl"
include optional=true "theme.kdl"

// Keep motion explicit: the defaults are animated, but this makes the
// compositor independent of any theme/config that could disable them.
animations {
    window-open { duration-ms 220; curve "ease-out-expo"; }
    window-close { duration-ms 180; curve "ease-out-quad"; }

    workspace-switch {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

input {
    mouse {
        accel-speed 0.0
    }
    touchpad {
        tap
        accel-speed 0.0
        natural-scroll
        dwt
    }
    keyboard {
        xkb {
            layout "us,ru"
            // Caps Lock stays a lock; the bar widget shows its state and case.
            options "grp:win_space_toggle,compose:menu"
        }
        track-layout "window"
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

output "HDMI-A-1" {
    mode "2240x960@119.898"
    scale 1
    position x=0 y=0
    variable-refresh-rate
}

output "eDP-1" {
    mode "1920x1080@60.164"
    scale 1
    // No explicit position: niri places outputs without one to the right of
    // all explicitly positioned outputs. HDMI is pinned at x=0, so the
    // laptop stays on the right for any HDMI mode/resolution.
    layout {
        always-center-single-column
    }
}

layout {
    gaps 12

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    border {
        width 2
    }

    focus-ring {
        width 0
    }

    tab-indicator {
        gap 5
        width 4
        length total-proportion=0.5
        position "left"
        gaps-between-tabs 0
        corner-radius 0
    }

    // Новые окна по умолчанию на всю ширину рабочей области.
    // Исключения задаются window-rule с default-column-width ниже/дальше.
    default-column-width { proportion 1.0; }
    center-focused-column "never"
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    // Draw only the border outline, not a filled rect behind the window:
    // otherwise the accent border tints translucent terminals when focused.
    draw-border-with-background false
}

// Omarchy-style glass terminal: ghostty renders a translucent background,
// niri blurs the wallpaper behind it (xray keeps it cheap on AMD).
window-rule {
    match app-id="^com.mitchellh.ghostty$"

    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="^org.gnome.Calculator$"
    match app-id="^org.keepassxc.KeePassXC$"
    open-floating true
}

window-rule {
    match app-id="xdg-desktop-portal-gtk"
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
    open-on-output "focused"
    geometry-corner-radius 0
}

window-rule {
    match app-id="^zen" title="^Picture-in-Picture$"
    open-floating true
}

// Маленький TUI-календарь из бара: плавающее окно фиксированного размера.
window-rule {
    match app-id="^calcurse$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 640; }
}

// Небольшой временный терминал для sudo-промптов и одноразовых действий.
window-rule {
    match app-id="^org.omarchy.transient$"
    open-floating true
    default-column-width { fixed 720; }
    default-window-height { fixed 420; }
}

// Compact prompt for the temporary-sudo password.
window-rule {
    match app-id="^org.omarchy.sudo$"
    open-floating true
    default-column-width { fixed 520; }
    default-window-height { fixed 260; }
}

// Full-size process monitor.
window-rule {
    match app-id="^org.omarchy.btop$"
    open-maximized true
}

environment {
    "GTK_USE_PORTAL" "1"
    "WLR_NO_HARDWARE_CURSORS" "1"
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=Niri:GNOME" "DISPLAY"

hotkey-overlay {
    skip-at-startup
}

gestures {
    hot-corners {
        off
    }
}
