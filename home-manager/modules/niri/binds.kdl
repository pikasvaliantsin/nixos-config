// Бинды Niri. Всё, что раньше шло через `dms ipc call`, теперь — обычные
// команды: omarchy-ipc/swayosd/gtklock/niri msg/playerctl/wpctl/dfiles.

binds {
    // --- session, launcher, notification center -------------------------------
    Alt+Space hotkey-overlay-title="App search" { spawn "omarchy-ipc" "call" "shell" "toggle" "omarchy.menu" "{\"menu\":\"apps\"}"; }
    Mod+D hotkey-overlay-title="Apps" { spawn "omarchy-ipc" "call" "shell" "toggle" "omarchy.menu" "{\"menu\":\"apps\"}"; }
    Mod+Escape hotkey-overlay-title="Menu" { spawn "omarchy-ipc" "call" "shell" "toggle" "omarchy.menu" "{\"menu\":\"root\"}"; }
    Mod+Shift+D hotkey-overlay-title="File search" { spawn "omarchy-ipc" "call" "local.file-search" "toggle"; }
    Mod+Shift+C hotkey-overlay-title="Calculator" { spawn "omarchy-ipc" "call" "local.calc" "toggle"; }
    Mod+Shift+X hotkey-overlay-title="Developer tools" { spawn "omarchy-ipc" "call" "devtools" "toggle"; }
    Mod+Alt+T hotkey-overlay-title="Themes" { spawn "omarchy-ipc" "call" "gallery" "themes"; }
    Mod+Shift+B hotkey-overlay-title="Wallpapers" { spawn "omarchy-ipc" "call" "gallery" "wallpapers"; }
    // Notification center is a custom plugin on top of omarchy-shell.
    Mod+N hotkey-overlay-title="Notifications" { spawn "omarchy-ipc" "call" "notifications" "toggle"; }
    // Clipboard history overlay (QML, Omarchy clipboard plugin).
    Mod+V hotkey-overlay-title="Clipboard" { spawn "omarchy-ipc" "call" "shell" "toggle" "omarchy.clipboard" "{}"; }
    Mod+Alt+L hotkey-overlay-title="Lock" { spawn "gtklock"; }
    Super+X hotkey-overlay-title="System" { spawn "omarchy-ipc" "call" "shell" "toggle" "omarchy.menu" "{\"menu\":\"system\"}"; }
    Mod+M hotkey-overlay-title="Process monitor" { spawn "foot" "--app-id=org.omarchy.btop" "--title=btop" "-o" "csd.preferred=none" "btop"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Process monitor" { spawn "foot" "--app-id=org.omarchy.btop" "--title=btop" "-o" "csd.preferred=none" "btop"; }

    // --- audio / microphone / brightness (with OSD) --------------------------------
    // Super + the keyboard volume knob drives the external monitor backlight.
    Super+XF86AudioRaiseVolume allow-when-locked=true cooldown-ms=250 { spawn "omarchy-brightness-external" "+5"; }
    Super+XF86AudioLowerVolume allow-when-locked=true cooldown-ms=250 { spawn "omarchy-brightness-external" "-5"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "omarchy-audio-output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "omarchy-audio-output-volume" "lower"; }
    XF86AudioMute allow-when-locked=true { spawn "omarchy-audio-output-volume" "mute-toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "omarchy-audio-input-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "omarchy-brightness-display" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "omarchy-brightness-display" "5%-"; }

    // --- media ------------------------------------------------------------
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    // --- wallpapers / screenshots -------------------------------------------------
    Mod+Shift+Tab repeat=false hotkey-overlay-title="Next wallpaper" { spawn "bg-next"; }
    Mod+Alt+Tab repeat=false hotkey-overlay-title="Previous wallpaper" { spawn "bg-prev"; }
    Mod+Y hotkey-overlay-title="Wallpaper picker" { spawn "omarchy-ipc" "call" "gallery" "wallpapers"; }
    XF86Launch1 { screenshot; }
    Super+Shift+S hotkey-overlay-title="Screenshot: region" { screenshot; }
    Mod+Ctrl+S hotkey-overlay-title="Screenshot: screen" { screenshot-screen; }
    Mod+Ctrl+Shift+S hotkey-overlay-title="Screenshot: window" { screenshot-window; }
    Ctrl+Shift+S hotkey-overlay-title="Last screenshot → clipboard" { spawn "last-shot"; }
    Ctrl+Alt+S hotkey-overlay-title="Screenshot → path to clipboard" { spawn "shot-path"; }
    Ctrl+XF86Launch1 { screenshot-screen; }
    Alt+XF86Launch1 { screenshot-window; }
    Alt+R hotkey-overlay-title="Screen recording" { spawn "omarchy-capture-screenrecording" "--fullscreen" "--with-desktop-audio"; }
    Alt+Shift+R hotkey-overlay-title="Region recording" { spawn "omarchy-capture-screenrecording" "--region" "--with-desktop-audio"; }

    // --- workspaces -------------------------------------------------------
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+I { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+I { move-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }

    // --- windows and columns ---------------------------------------------------
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    // Mod+K opens the keybinding sheet; focus-up stays on Mod+Up.
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Q repeat=false { close-window; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+F { maximize-column; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+R { switch-preset-column-width; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }

    // --- overview / misc ---------------------------------------------------
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+K hotkey-overlay-title="Keybindings" { spawn "omarchy-ipc" "call" "keybinds" "toggle"; }
    Mod+Shift+Slash hotkey-overlay-title="Keybindings" { spawn "omarchy-ipc" "call" "keybinds" "toggle"; }
    Mod+Shift+P hotkey-overlay-title="Monitors off" { power-off-monitors; }
    Mod+Shift+Escape allow-inhibiting=false hotkey-overlay-title="Toggle shortcuts inhibit" { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E hotkey-overlay-title="Quit niri" { quit; }

    // --- applications -------------------------------------------------------
    Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    // Superwhisper push-to-talk. niri-git guarantees the release action runs
    // whenever the press action ran. Compose is on the Menu key now.
    Alt_R {
        press { spawn "/etc/profiles/per-user/valen/bin/superwhisper" "record" "start"; }
        release { spawn "/etc/profiles/per-user/valen/bin/superwhisper" "record" "stop"; }
    }
    Mod+T hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+E repeat=false hotkey-overlay-title="Files" { spawn "dfiles" "toggle"; }
    Mod+B hotkey-overlay-title="Zen browser" { spawn "zen"; }
    Mod+Ctrl+B hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Super+G repeat=false hotkey-overlay-title="Steam" { spawn "steam"; }
    Mod+Alt+B hotkey-overlay-title="Bite Alarm" { spawn "bite-alarm-toggle"; }
    Mod+Alt+R hotkey-overlay-title="Reel Hold" { spawn "reel-hold"; }
}
