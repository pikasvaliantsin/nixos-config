// input/touchpad/keyboard и cursor — зона DMS:
// ~/.config/niri/dms/input.kdl и dms/cursor.kdl.
// Здесь оставляем только то, что DMS не генерирует.

// ВАЖНО: не держим здесь правила output — niri берёт первое совпавшее правило
// для выхода, поэтому они перебивают ~/.config/niri/dms/outputs.kdl, который
// DMS генерирует из выбранного профиля. Всё управление выходами — через DMS.
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

layout {
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
    tab-indicator {
        gap 5.000000
        width 4.000000
        length total-proportion=0.500000
        position "left"
        gaps-between-tabs 0.000000
        corner-radius 0.000000
    }
    default-column-width { proportion 0.500000; }
    center-focused-column "never"
}

environment {
    "GTK_USE_PORTAL" "1"
    "WLR_NO_HARDWARE_CURSORS" "1"
}

binds {
    Mod+B { spawn "zen"; }
    "Shift+Page_Up" repeat=false { spawn "./scripts/toogle_key.sh"; }
    Super+G repeat=false { spawn "steam"; }
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=Niri:GNOME" "DISPLAY"
// DMS запускается как systemd-юнит (programs.dank-material-shell.systemd.enable),
// поэтому здесь его больше не спавним — иначе будет второй экземпляр.
hotkey-overlay {
    skip-at-startup
}

window-rule {
    geometry-corner-radius 12.000000 12.000000 12.000000 12.000000
    clip-to-geometry true
}
window-rule {
    match app-id="^org.gnome.Calculator$"
    match app-id="^org.keepassxc.KeePassXC$"
    open-floating true
}
window-rule {
    match app-id="xdg-desktop-portal-gtk"
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
    open-on-output "focused"
    geometry-corner-radius 12.000000 12.000000 12.000000 12.000000
}
window-rule {
    match app-id="^zen" title="^Picture-in-Picture$"
    open-floating true
}
gestures { hot-corners { off; }; }
