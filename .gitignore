# --- NixOS/Nix Cache Symlink ---
result
result-[^/]*
# --- Direnv ---
.direnv/
.envrc
# --- Nix Derivations & Outputs ---
*.drv
*.nar
*.nar.xz
*.out
# --- Home Manager ---
home-manager/result
home-manager/.home-manager-*
# --- QEMU / VM Disks ---
*.qcow2
*.qcow2.*
*.img
*.vmdk
# --- Age Key Files ---
*.age
# --- Secrets Data ---
secrets/secrets.decrypted
# --- Editors ---
*.swp
*.swo
*~
.DS_Store
Thumbs.db
# --- Logs ---
*.log
.aider*
# --- IDE ---
.idea/
.vscode/
# --- DMS runtime state (может содержать API-ключи) ---
home-manager/modules/dms/app/plugin_settings.json

# DMS генерирует этот файл сам (миграция биндов)
home-manager/modules/dms/config/binds-next.kdl
