// Минимальный конфиг niri для теста RF4: без Omarchy/DMS/dux.
// Основная задача — HDMI-A-1 2240x960@120, терминал и запуск rf4-gs.

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle,compose:menu,ctrl:nocaps"
        }
        numlock
        track-layout "window"
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

layout {
    gaps 8
    default-column-width { proportion 1.0; }
    center-focused-column "never"
    border {
        width 2
    }
    focus-ring {
        width 0
    }
}

output "HDMI-A-1" {
    mode "2240x960@119.898"
    scale 1
    position x=0 y=0
    variable-refresh-rate
}

output "eDP-1" {
    mode "1920x1080@60.164"
    scale 1
}

// gamescope для RF4 всегда на внешнем 120 Гц мониторе и во весь экран.
window-rule {
    match app-id="^gamescope$"
    open-on-output "HDMI-A-1"
    open-fullscreen true
}

environment {
    "GTK_USE_PORTAL" "1"
    "WLR_NO_HARDWARE_CURSORS" "1"
    // Раскладка для Xwayland / gamescope.
    "XKB_DEFAULT_LAYOUT" "us,ru"
    "XKB_DEFAULT_OPTIONS" "grp:win_space_toggle,compose:menu,ctrl:nocaps"
    "DISABLE_XIM" "1"
    "GTK_IM_MODULE" "simple"
    "QT_IM_MODULE" "simple"
    "XMODIFIERS" "@im=none"
    // xwayland-satellite создаёт :0.
    "DISPLAY" ":0"
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=Niri:GNOME" "DISPLAY" "NIRI_SOCKET"
spawn-at-startup "xwayland-satellite"

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Return { spawn "foot"; }
    Mod+T { spawn "foot"; }
    Mod+B { spawn "firefox"; }
    Mod+Q repeat=false { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+F { fullscreen-window; }
    Mod+F { maximize-column; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+S { screenshot; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp { focus-workspace-up; }
}
