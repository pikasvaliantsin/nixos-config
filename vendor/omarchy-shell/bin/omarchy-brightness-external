#!/bin/bash

# omarchy:summary=Adjust the external monitor backlight over DDC/CI
# omarchy:args=<+N|-N>
# omarchy:examples=omarchy-brightness-external +5 | omarchy-brightness-external -5

set -euo pipefail

step="${1:-}"
[[ $step =~ ^[+-][0-9]+$ ]] || { echo "usage: omarchy-brightness-external <+N|-N>" >&2; exit 2; }

command -v ddcutil >/dev/null 2>&1 || { echo "omarchy-brightness-external: ddcutil missing" >&2; exit 1; }
command -v omarchy-brightness-display-ddc >/dev/null 2>&1 || { echo "omarchy-brightness-external: DDC helper missing" >&2; exit 1; }

# Find a connected external output that is currently on.  DDC to a sleeping
# monitor can block for a long time, and on AMDGPU a full i2c bus scan can
# wedge the display engine (ddcutil issue #223).
monitor=""
for status in /sys/class/drm/card*-HDMI-A-*/status /sys/class/drm/card*-DP-*/status; do
  [[ -r $status ]] || continue
  [[ $(<"$status") == connected ]] || continue
  dir=${status%/status}
  dpms="$dir/dpms"
  if [[ -r $dpms && $(<"$dpms") != On ]]; then
    continue
  fi
  name=${dir##*/}
  monitor=${name#*-}
  break
done
[[ -n $monitor ]] || exit 0

# The DDC helper speaks percentages; the keybind passes raw steps.
if [[ $step == +* ]]; then
  step="+${step#+}%"
else
  step="${step#-}%-"
fi

# Serialize brightness calls.  A second key event is dropped while one DDC
# transaction is in flight; this is what prevents the ddcutil process storm
# that hard-hung the display engine on 2026-11-15.
runtime="${XDG_RUNTIME_DIR:-/tmp}"
exec 9>"$runtime/omarchy-brightness-display.lock"
flock -n 9 || exit 0

brightness=$(omarchy-brightness-display-ddc "$monitor" "$step") || exit 1
if command -v omarchy-osd >/dev/null 2>&1; then
  omarchy-osd -i brightness -p "$brightness" >/dev/null 2>&1 || true
fi
