#!/bin/bash
# State for the Display panel: brightness, monitor layout, scale, displays.
# Niri equivalent of Omarchy's Hyprland monitor-state helper.

set -euo pipefail

outputs=$(niri msg --json outputs 2>/dev/null || echo '{}')
focused=$(niri msg --json focused-output 2>/dev/null | jq -r '.name // ""')

brightness=$(omarchy-brightness-display --monitor "$focused" 2>/dev/null || true)
[[ -n $brightness ]] || brightness="unavailable"

internal=$(printf '%s' "$outputs" | jq -r '
  to_entries
  | map(select(.key | test("^(eDP|LVDS|DSI)-")))
  | .[0].key // ""')
external=$(printf '%s' "$outputs" | jq -r '
  to_entries
  | map(select(.key | test("^(eDP|LVDS|DSI)-") | not))
  | .[0].key // ""')

internal_enabled=$(printf '%s' "$outputs" | jq -r --arg n "$internal" '
  if $n != "" and .[$n].logical != null then $n else "" end')
scale=$(printf '%s' "$outputs" | jq -r --arg n "$focused" '
  if $n != "" then (.[$n].logical.scale // "" | tostring) else "" end')

displays=$(printf '%s' "$outputs" | jq -c --arg focused "$focused" '
  [to_entries[] |
    .key as $name |
    .value as $v |
    (if $v.current_mode == null then null else $v.modes[$v.current_mode] end) as $cur |
    {
      name: $name,
      enabled: ($v.logical != null),
      focused: ($name == $focused),
      width: ($cur.width // 0),
      height: ($cur.height // 0),
      resolution: (if $cur == null then "" else "\($cur.width)x\($cur.height)" end),
      resolutions: (
        [ $v.modes[] | {width, height, refresh_rate} ]
        | group_by([.width, .height])
        | map(max_by(.refresh_rate))
        | sort_by(-(.width * .height), -.width, -.height)
      )
    }] | sort_by(.name)')

printf '%s\n' "$brightness"
printf '%s\n' "$internal"
printf '%s\n' "$external"
printf '%s\n' "$internal_enabled"
printf '\n'
printf '%s\n' "$focused"
printf '%s\n' "$scale"
printf '%s\n' "$displays"
