#!/bin/bash

# omarchy:summary=Launch a URL as a web app in a Chromium-based browser
# omarchy:args=<url> [extra browser args...]

set -euo pipefail

url="${1:-}"
[[ -n $url ]] || { echo "usage: omarchy-launch-webapp <url>" >&2; exit 2; }
shift || true

# A web app started by the shell stays in omarchy-shell.service's cgroup and
# dies when that service restarts. Put every launch in its own app.slice scope;
# a terminal or another app scope is already detached. The shell itself also
# lives under app.slice, so match its unit explicitly.
if [ -z "${OMARCHY_WEBAPP_SCOPED:-}" ]; then
  webapp_cgroup=$(cat /proc/self/cgroup 2>/dev/null || true)
  case "$webapp_cgroup" in
    *"/omarchy-shell.service"*) ;;
    *"/app.slice/"*) ;;
    *)
      export OMARCHY_WEBAPP_SCOPED=1
      exec systemd-run --user --scope --collect --quiet --slice=app.slice -- \
        "$(readlink -f "$0")" "$url" "$@"
      ;;
  esac
fi

# Chromium's PWA titlebar takes its window controls from the GTK theme. The
# Catppuccin GTK theme this desktop uses paints the close hover with its pink
# error colour and the X disappears into it; the neutral Adwaita variant keeps
# the icon visible. Follow the active generated theme's light/dark mode.
theme_state="${XDG_STATE_HOME:-$HOME/.local/state}/theme/current"
gtk_variant="Adwaita:dark"
if [ -r "$theme_state/colors.toml" ]; then
  theme_mode=$(awk -F'"' '/^mode[[:space:]]*=/{print $2; exit}' "$theme_state/colors.toml" 2>/dev/null || true)
  [ "$theme_mode" = "light" ] && gtk_variant="Adwaita"
fi
export GTK_THEME="${GTK_THEME:-$gtk_variant}"

browser="${OMARCHY_WEBAPP_BROWSER:-}"
if [[ -n $browser && ! -x $browser ]]; then
  browser=$(command -v "$browser" 2>/dev/null || true)
fi

if [[ -z $browser || ! -x $browser ]]; then
  browser=""
  for candidate in chromium chromium-browser google-chrome-stable google-chrome brave-browser microsoft-edge-stable opera vivaldi-stable; do
    if found=$(command -v "$candidate" 2>/dev/null); then
      browser=$found
      break
    fi
  done
fi

if [[ -z $browser ]]; then
  echo "omarchy-launch-webapp: no Chromium-based browser found" >&2
  exit 1
fi

exec "$browser" \
  --app="$url" \
  --password-store=basic \
  --ozone-platform-hint=wayland \
  --no-first-run \
  --no-default-browser-check \
  "$@"
