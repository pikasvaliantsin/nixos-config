#!/bin/bash

# omarchy:summary=Create a desktop launcher for a web app
# omarchy:args=[name url icon-url-or-name [custom-exec] [mime-types]]

set -euo pipefail

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="$HOME/.local/share/applications"

safe_icon_name() {
  printf '%s\n' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

icon_name_from_ref() {
  local ref="$1" name
  name=$(basename "$ref")
  if [[ $name == *.* ]]; then
    safe_icon_name "${name%.*}"
  else
    printf '%s\n' "$name"
  fi
}

install_user_icon() {
  local source="$1" name="$2" ext
  ext="${source##*.}"
  [[ $ext == "$source" ]] && ext="png"
  mkdir -p "$ICON_DIR"
  cp "$source" "$ICON_DIR/$name.$ext"
  gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  printf '%s\n' "$name"
}

download_icon() {
  local url="$1" dest="$2"
  curl -fsSL --max-time 10 -o "$dest" "$url" 2>/dev/null || return 1
  [[ -s $dest ]] || return 1
  if command -v file >/dev/null 2>&1; then
    [[ $(file -b --mime-type "$dest") == image/* ]] || return 1
  fi
  return 0
}

fetch_site_icon() {
  local site_url="$1" dest="$2"
  local origin page icon_url host
  origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site_url")
  host=${site_url#*://}
  host=${host%%/*}
  host=${host%%\?*}
  host=${host%%#*}
  host=${host%:*}

  page=$(curl -fsSL --max-time 5 "$site_url" 2>/dev/null | head -c 100000 | tr '\n' ' ' || true)
  icon_url=$(grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"$page" \
    | grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//" || true)

  case $icon_url in
    http://* | https://*) ;;
    //*) icon_url="https:$icon_url" ;;
    /*) icon_url="$origin$icon_url" ;;
    ?*) icon_url="$origin/$icon_url" ;;
  esac

  { [[ -n $icon_url ]] && download_icon "$icon_url" "$dest"; } \
    || download_icon "$origin/apple-touch-icon.png" "$dest" \
    || download_icon "https://www.google.com/s2/favicons?domain=${host}&sz=256" "$dest"
}

# Escape a value for Name=/Comment= in a desktop entry.
desktop_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}
  printf '%s' "$value"
}

# Quote one Exec argument: desktop parsers expand %X as field codes.
desktop_exec_arg() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\`/\\\`}
  value=${value//\$/\\$}
  value=${value//\"/\\\"}
  value=${value//%/%%}
  printf '"%s"' "$value"
}

# Chromium names an --app window after the URL:
#   https://open.spotify.com/ -> chrome-open.spotify.com__-Default
#   https://app.hey.com        -> chrome-app.hey.com__-Default
window_class() {
  local url="$1" rest host path
  rest=${url#*://}
  host=${rest%%/*}
  host=${host%%\?*}
  host=${host%%#*}
  host=${host%:*}
  path=${rest#"$host"}
  path=${path%%\?*}
  path=${path%%#*}
  [[ -z $path ]] && path="/"
  printf 'chrome-%s_%s-Default\n' "${host,,}" "${path//\//_}"
}

if (( $# < 3 )); then
  echo -e "\e[32mLet's create a new web app you can start with the app launcher.\n\e[0m"
  if ! command -v gum >/dev/null 2>&1; then
    echo "omarchy-webapp-install: gum is required for interactive mode" >&2
    exit 1
  fi

  APP_NAME=$(gum input --prompt "Name> " --placeholder "My favorite web app")
  APP_URL=$(gum input --prompt "URL> " --placeholder "https://example.com")
  [[ $APP_URL =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || APP_URL="https://$APP_URL"

  ICON_REF=""
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"
  if fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png"; then
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
    ICON_REF="$ICON_VALUE"
  else
    ICON_REF=$(gum input --prompt "Icon URL/name> " --placeholder "Could not fetch favicon automatically. Enter PNG icon URL or icon name")
  fi

  CUSTOM_EXEC=""
  MIME_TYPES=""
  INTERACTIVE_MODE=true
else
  APP_NAME="$1"
  APP_URL="$2"
  [[ $APP_URL =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || APP_URL="https://$APP_URL"
  ICON_REF="${3:-}"
  CUSTOM_EXEC="${4:-}"
  MIME_TYPES="${5:-}"
  INTERACTIVE_MODE=false
fi

[[ -n $APP_NAME && -n $APP_URL ]] || {
  echo "You must set app name and app URL!" >&2
  exit 1
}

if [[ -z $ICON_REF ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"
  if fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png"; then
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  else
    ICON_VALUE="webapp"
  fi
elif [[ $ICON_REF =~ ^https?:// ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"
  if download_icon "$ICON_REF" "$ICON_DIR/$ICON_VALUE.png"; then
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  else
    echo "warning: failed to download icon; using the generic webapp icon" >&2
    ICON_VALUE="webapp"
  fi
elif [[ -f $ICON_REF ]]; then
  ICON_VALUE=$(install_user_icon "$ICON_REF" "$(safe_icon_name "$APP_NAME")") || ICON_VALUE="webapp"
else
  ICON_VALUE=$(icon_name_from_ref "$ICON_REF")
fi

wmclass=$(window_class "$APP_URL")
exec_command="${CUSTOM_EXEC:-omarchy-launch-webapp $(desktop_exec_arg "$APP_URL")}"
desktop_file="$DESKTOP_DIR/$APP_NAME.desktop"
mkdir -p "$DESKTOP_DIR"

cat >"$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$(desktop_escape "$APP_NAME")
Comment=$(desktop_escape "$APP_NAME")
Exec=$exec_command
Icon=$ICON_VALUE
Terminal=false
StartupNotify=true
StartupWMClass=$wmclass
Categories=Network;
EOF

if [[ -n $MIME_TYPES ]]; then
  printf 'MimeType=%s\n' "$MIME_TYPES" >>"$desktop_file"
fi

chmod +x "$desktop_file"
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
fi

if [[ $INTERACTIVE_MODE == "true" ]]; then
  echo -e "You can now find $APP_NAME using the app launcher (SUPER + SPACE)\n"
fi
