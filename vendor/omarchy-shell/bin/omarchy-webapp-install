#!/bin/bash

# omarchy:summary=Create a desktop launcher for a web app
# omarchy:args=[name url [icon-url-or-name [custom-exec] [mime-types]]]

set -euo pipefail

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="$HOME/.local/share/applications"

AUTO_NAME=""
AUTO_ICON_URL=""

safe_icon_name() {
  printf '%s\n' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

icon_name_from_ref() {
  local ref="$1" name
  name=$(basename "$ref")
  if [[ $name == *.* ]]; then
    safe_icon_name "${name%.*}"
  else
    printf '%s\n' "$name"
  fi
}

install_user_icon() {
  local source="$1" name="$2" ext
  ext="${source##*.}"
  [[ $ext == "$source" ]] && ext="png"
  mkdir -p "$ICON_DIR"
  cp "$source" "$ICON_DIR/$name.$ext"
  gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  printf '%s\n' "$name"
}

download_icon() {
  local url="$1" dest="$2"
  curl -fsSL --max-time 10 -o "$dest" "$url" 2>/dev/null || return 1
  [[ -s $dest ]] || return 1
  if command -v file >/dev/null 2>&1; then
    [[ $(file -b --mime-type "$dest") == image/* ]] || return 1
  fi
  return 0
}

origin_of() {
  sed -E 's|^(https?://[^/]+).*|\1|' <<<"$1"
}

host_of() {
  local rest=${1#*://}
  rest=${rest%%/*}
  rest=${rest%%\?*}
  rest=${rest%%#*}
  rest=${rest%:*}
  printf '%s\n' "${rest,,}"
}

# Resolve href/src values from a page or manifest against its base URL.
url_resolve() {
  local base="$1" ref="$2" origin
  origin=$(origin_of "$base")
  case $ref in
    http://* | https://*) printf '%s\n' "$ref" ;;
    //*) printf 'https:%s\n' "$ref" ;;
    /*) printf '%s\n' "$origin$ref" ;;
    *) printf '%s\n' "${base%/*}/$ref" ;;
  esac
}

decode_entities() {
  local value="$1"
  value=${value//&amp;/&}
  value=${value//&quot;/\"}
  value=${value//&#39;/\'}
  value=${value//&lt;/<}
  value=${value//&gt;/>}
  printf '%s\n' "$value"
}

# Fill AUTO_NAME and AUTO_ICON_URL from the page title, web app manifest name
# and the largest manifest icon.  Falls back to the host name.
fetch_site_metadata() {
  local site_url="$1" page manifest_url manifest origin mname
  AUTO_NAME=""
  AUTO_ICON_URL=""
  origin=$(origin_of "$site_url")

  page=$(curl -fsSL --max-time 5 "$site_url" 2>/dev/null | head -c 200000 | tr '\n' ' ' || true)
  if [[ -n $page ]]; then
    AUTO_NAME=$(sed -n 's:.*<title[^>]*>\([^<]*\)</title>.*:\1:p' <<<"$page" | head -1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || true)
    AUTO_NAME=$(decode_entities "$AUTO_NAME")

    manifest_url=$(grep -oiE "<link[^>]*rel=[\"']manifest[\"'][^>]*>" <<<"$page" \
      | grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//" || true)
    if [[ -n $manifest_url ]]; then
      manifest_url=$(url_resolve "${origin}/" "$manifest_url")
      manifest=$(curl -fsSL --max-time 5 "$manifest_url" 2>/dev/null || true)
      if [[ -n $manifest ]] && command -v jq >/dev/null 2>&1; then
        mname=$(jq -r '.short_name // .name // empty' <<<"$manifest" 2>/dev/null || true)
        [[ -n $mname ]] && AUTO_NAME=$mname
        AUTO_ICON_URL=$(jq -r '
          (.icons // [])
          | map(select(.src != null))
          | sort_by((.sizes // "0") | split("x")[0] | tonumber? // 0)
          | reverse
          | .[0].src // empty
        ' <<<"$manifest" 2>/dev/null || true)
        [[ -n $AUTO_ICON_URL ]] && AUTO_ICON_URL=$(url_resolve "$manifest_url" "$AUTO_ICON_URL")
      fi
    fi
  fi

  [[ -n $AUTO_NAME ]] || AUTO_NAME=$(host_of "$site_url")
}

fetch_best_icon() {
  local site_url="$1" dest="$2" origin host url
  origin=$(origin_of "$site_url")
  host=$(host_of "$site_url")

  local candidates=()
  [[ -n $AUTO_ICON_URL ]] && candidates+=("$AUTO_ICON_URL")
  candidates+=(
    "$origin/apple-touch-icon.png"
    "https://www.google.com/s2/favicons?domain=${host}&sz=256"
    "$origin/favicon.ico"
  )

  for url in "${candidates[@]}"; do
    if download_icon "$url" "$dest"; then
      return 0
    fi
  done
  return 1
}

# Escape a value for Name=/Comment= in a desktop entry.
desktop_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}
  printf '%s' "$value"
}

# Quote one Exec argument: desktop parsers expand %X as field codes.
desktop_exec_arg() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\`/\\\`}
  value=${value//\$/\\$}
  value=${value//\"/\\\"}
  value=${value//%/%%}
  printf '"%s"' "$value"
}

# Chromium names an --app window after the URL:
#   https://open.spotify.com/ -> chrome-open.spotify.com__-Default
#   https://app.hey.com        -> chrome-app.hey.com__-Default
window_class() {
  local url="$1" rest host path
  rest=${url#*://}
  host=${rest%%/*}
  host=${host%%\?*}
  host=${host%%#*}
  host=${host%:*}
  path=${rest#"$host"}
  path=${path%%\?*}
  path=${path%%#*}
  [[ -z $path ]] && path="/"
  printf 'chrome-%s_%s-Default\n' "${host,,}" "${path//\//_}"
}

if (( $# < 2 )); then
  echo -e "\e[32mLet's create a new web app you can start with the app launcher.\n\e[0m"
  if ! command -v gum >/dev/null 2>&1; then
    echo "omarchy-webapp-install: gum is required for interactive mode" >&2
    exit 1
  fi

  APP_URL=$(gum input --prompt "URL> " --placeholder "https://example.com")
  [[ $APP_URL =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || APP_URL="https://$APP_URL"

  echo "Looking up name and icon..."
  fetch_site_metadata "$APP_URL"
  APP_NAME=$(gum input --prompt "Name> " --value "$AUTO_NAME")
  [[ -n $APP_NAME ]] || APP_NAME=$AUTO_NAME

  ICON_REF=""
  CUSTOM_EXEC=""
  MIME_TYPES=""
  INTERACTIVE_MODE=true
else
  APP_NAME="$1"
  APP_URL="$2"
  [[ $APP_URL =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || APP_URL="https://$APP_URL"
  ICON_REF="${3:-}"
  CUSTOM_EXEC="${4:-}"
  MIME_TYPES="${5:-}"
  INTERACTIVE_MODE=false

  if [[ -z $ICON_REF ]]; then
    echo "Looking up name and icon..."
    fetch_site_metadata "$APP_URL"
  fi
fi

[[ -n ${APP_NAME:-} && -n $APP_URL ]] || {
  echo "You must set app name and app URL!" >&2
  exit 1
}

mkdir -p "$ICON_DIR"

if [[ -n $ICON_REF ]]; then
  if [[ $ICON_REF =~ ^https?:// ]]; then
    ICON_VALUE=$(safe_icon_name "$APP_NAME")
    if ! download_icon "$ICON_REF" "$ICON_DIR/$ICON_VALUE.png"; then
      echo "warning: failed to download icon; trying the site automatically" >&2
      if ! fetch_best_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png"; then
        ICON_VALUE="webapp"
      fi
    fi
  elif [[ -f $ICON_REF ]]; then
    ICON_VALUE=$(install_user_icon "$ICON_REF" "$(safe_icon_name "$APP_NAME")") || ICON_VALUE="webapp"
  else
    ICON_VALUE=$(icon_name_from_ref "$ICON_REF")
  fi
else
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  if ! fetch_best_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png"; then
    echo "warning: could not fetch an icon; using the generic webapp icon" >&2
    ICON_VALUE="webapp"
  fi
fi

gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true

wmclass=$(window_class "$APP_URL")

# Some docks look up the icon by StartupWMClass rather than by Icon=.
if [[ -f "$ICON_DIR/$ICON_VALUE.png" ]]; then
  cp -f "$ICON_DIR/$ICON_VALUE.png" "$ICON_DIR/$wmclass.png" 2>/dev/null || true
  gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
fi

exec_command="${CUSTOM_EXEC:-omarchy-launch-webapp $(desktop_exec_arg "$APP_URL")}"
desktop_file="$DESKTOP_DIR/$APP_NAME.desktop"
mkdir -p "$DESKTOP_DIR"

cat >"$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$(desktop_escape "$APP_NAME")
Comment=$(desktop_escape "$APP_NAME")
Exec=$exec_command
Icon=$ICON_VALUE
Terminal=false
StartupNotify=true
StartupWMClass=$wmclass
Categories=Network;
X-Omarchy-WebApp=true
X-Omarchy-WebApp-URL=$(desktop_escape "$APP_URL")
EOF

if [[ -n $MIME_TYPES ]]; then
  printf 'MimeType=%s\n' "$MIME_TYPES" >>"$desktop_file"
fi

chmod +x "$desktop_file"
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
fi

if [[ $INTERACTIVE_MODE == "true" ]]; then
  echo -e "You can now find $APP_NAME using the app launcher (SUPER + SPACE)\n"
fi
