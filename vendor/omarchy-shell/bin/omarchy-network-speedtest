#!/bin/bash
# One direction of the network speed test for the Omarchy panel.
# omarchy-speedtest streams progress lines and a final rate; the panel
# consumes those lines directly.
set -euo pipefail

direction=${1:?usage: omarchy-network-speedtest [down|up]}
case "$direction" in down|up) ;; *) echo "usage: omarchy-network-speedtest [down|up]" >&2; exit 2 ;; esac

client=${OMARCHY_SPEEDTEST_BINARY:-$(command -v omarchy-speedtest || true)}
if [[ -z $client || ! -x $client ]]; then
  echo "The speed test client is missing: install omarchy-speedtest" >&2
  exit 1
fi

export OMARCHY_SPEEDTEST_PARENT_PID=$PPID
exec "$client" "$direction"
