#!/bin/bash
# Screenshot helper used by the capture menu. Saves, copies and notifies.
# Usage: omarchy-capture-screenshot [region|screen|window]

set -euo pipefail

mode=${1:-region}
dir="${OMARCHY_SCREENSHOT_DIR:-$HOME/Pictures/Screenshots}"
mkdir -p "$dir"
file="$dir/screenshot-$(date +'%Y-%m-%d_%H-%M-%S-%N').png"

case "$mode" in
  region)
    geom=$(slurp) || exit 0
    [[ -n $geom ]] || exit 0
    grim -g "$geom" "$file"
    ;;
  screen)
    output=$(niri msg --json focused-output 2>/dev/null | jq -r '.name // empty')
    [[ -n $output ]] || exit 1
    grim -o "$output" "$file"
    ;;
  window)
    id=$(niri msg --json pick-window 2>/dev/null | jq -er '.id') || exit 0
    niri msg action screenshot-window --id "$id" --path "$file" >/dev/null
    # niri writes the file asynchronously after acknowledging the action.
    for _ in $(seq 1 100); do
      [[ -s $file ]] && break
      sleep 0.05
    done
    [[ -s $file ]] || exit 1
    ;;
  *)
    echo "Usage: omarchy-capture-screenshot [region|screen|window]" >&2
    exit 2
    ;;
esac

wl-copy --type image/png <"$file"
notify-send -a "Screenshot" "Screenshot saved" "$file" 2>/dev/null || true
