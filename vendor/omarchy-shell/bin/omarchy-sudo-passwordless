#!/bin/bash
# NixOS/niri variant of Omarchy's temporary passwordless sudo.
# Usage: omarchy-sudo-passwordless [MINUTES|--active|--disable]
# Enable requires root and is normally launched via sudo in a terminal.

set -euo pipefail

uid=${SUDO_UID:-$(id -u)}
user=${SUDO_USER:-$(id -un)}
file="/etc/sudoers.d/99-omarchy-nopasswd-$uid"
marker="/run/user/$uid/omarchy-sudo-passwordless"
sudo=/run/wrappers/bin/sudo
visudo=$(command -v visudo || true)

active_from_marker() {
  [[ -f $marker ]] || return 1
  local expiry now
  expiry=$(cat "$marker" 2>/dev/null || echo 0)
  now=$(date +%s)
  if [[ $expiry =~ ^[0-9]+$ ]] && (( expiry > now )); then
    return 0
  fi
  rm -f "$marker" 2>/dev/null || true
  return 1
}

case "${1:-}" in
  --active)
    if (( EUID == 0 )); then
      [[ -e $file ]]
    else
      active_from_marker
    fi
    exit $?
    ;;
  --disable)
    if (( EUID != 0 )); then
      exec "$sudo" -n "$0" --disable
    fi
    rm -f "$file" "$marker"
    exit 0
    ;;
esac

minutes=${1:-15}
[[ $minutes =~ ^[0-9]+$ ]] && (( minutes >= 1 && minutes <= 1440 )) || {
  echo "Usage: omarchy-sudo-passwordless [1-1440|--active|--disable]" >&2
  exit 2
}

if (( EUID != 0 )); then
  exec "$sudo" "$0" "$minutes"
fi

[[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || exit 1
[[ -n $visudo ]] || { echo "visudo not found" >&2; exit 1; }
[[ -d /etc/sudoers.d ]] || { echo "/etc/sudoers.d does not exist" >&2; exit 1; }

expires=$(( $(date +%s) + minutes * 60 ))
deadline=$(date -u -d "@$expires" +%Y%m%d%H%M%SZ)
tmp=$(mktemp /etc/sudoers.d/.omarchy-nopasswd.XXXXXX)
trap 'rm -f "$tmp"' EXIT
printf '%s ALL=(ALL) NOTAFTER=%s NOPASSWD: ALL\n' "$user" "$deadline" >"$tmp"
chown root:root "$tmp"
chmod 0440 "$tmp"
"$visudo" -cf "$tmp" >/dev/null
mv -fT "$tmp" "$file"
trap - EXIT
mkdir -p "/run/user/$uid"
printf '%s\n' "$expires" >"$marker"
chown "$uid:$uid" "$marker"
echo "Passwordless sudo enabled for $user until $deadline"
