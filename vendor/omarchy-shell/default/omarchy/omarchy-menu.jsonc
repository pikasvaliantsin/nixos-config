{
  // Minimal menu for this NixOS/niri port. The upstream Omarchy menu is full
  // of Hyprland/Arch actions that do not exist here; this file keeps the
  // parts that map to the packages and helpers actually installed.
  "apps": {
    "icon": "󰀻",
    "label": "Apps",
    "aliases": ["app", "applications"],
    "provider": "apps"
  },
  "files": {
    "icon": "󰈞",
    "label": "Files",
    "aliases": ["files", "find", "dsearch"],
    "action": "omarchy-ipc call local.file-search toggle"
  },
  "calculator": {
    "icon": "󰃬",
    "label": "Calculator",
    "aliases": ["calc", "qalc"],
    "action": "omarchy-ipc call local.calc toggle"
  },
  "style": {
    "icon": "󰏘",
    "label": "Style",
    "aliases": ["theme", "appearance", "wallpaper", "background"]
  },
  "style.themes": {
    "icon": "󰏘",
    "label": "Themes",
    "aliases": ["carousel"],
    "action": "omarchy-ipc call gallery themes"
  },
  "style.wallpapers": {
    "icon": "󰸉",
    "label": "Wallpapers",
    "aliases": ["backgrounds", "carousel"],
    "action": "omarchy-ipc call gallery wallpapers"
  },
  "keybindings": {
    "icon": "󰌌",
    "label": "Keybindings",
    "aliases": ["keys", "shortcuts", "hotkeys"],
    "action": "omarchy-ipc call keybinds toggle"
  },
  "capture": {
    "icon": "",
    "label": "Capture",
    "aliases": ["screenshot", "screenrecord"]
  },
  "capture.screenshot-region": {
    "icon": "",
    "label": "Screenshot: region",
    "action": "omarchy-capture-screenshot region"
  },
  "capture.screenshot-screen": {
    "icon": "",
    "label": "Screenshot: screen",
    "action": "omarchy-capture-screenshot screen"
  },
  "capture.record": {
    "icon": "",
    "label": "Record",
    "aliases": ["record", "screenrecord", "screen-record"]
  },
  "capture.record.stop": {
    "icon": "",
    "label": "Stop recording",
    "when": "omarchy-capture-screenrecording --status",
    "action": "omarchy-capture-screenrecording --stop-recording"
  },
  "capture.record.desktop": {
    "icon": "",
    "label": "Screen + desktop audio",
    "action": "omarchy-capture-screenrecording --fullscreen --with-desktop-audio"
  },
  "capture.record.both": {
    "icon": "",
    "label": "Screen + desktop + mic",
    "action": "omarchy-capture-screenrecording --fullscreen --with-desktop-audio --with-microphone-audio"
  },
  "capture.record.silent": {
    "icon": "",
    "label": "Screen without audio",
    "action": "omarchy-capture-screenrecording --fullscreen"
  },
  "capture.record.region": {
    "icon": "",
    "label": "Region + desktop audio",
    "action": "omarchy-capture-screenrecording --region --with-desktop-audio"
  },
  "install": {
    "icon": "󰉉",
    "label": "Install",
    "aliases": ["install"]
  },
  "install.webapp": {
    "icon": "",
    "label": "Web App",
    "action": "omarchy-launch-floating-terminal omarchy-webapp-install"
  },
  "remove": {
    "icon": "󰭌",
    "label": "Remove",
    "aliases": ["uninstall", "remove"]
  },
  "remove.webapp": {
    "icon": "",
    "label": "Web App",
    "when": "grep -qE '^Exec=.*(omarchy-launch-webapp|omarchy-webapp-handler)' $HOME/.local/share/applications/*.desktop",
    "action": "omarchy-launch-floating-terminal omarchy-webapp-remove"
  },
  "system": {
    "icon": "",
    "label": "System",
    "aliases": ["power", "power-menu"]
  },
  "system.lock": {
    "icon": "",
    "label": "Lock",
    "action": "gtklock"
  },
  "system.logout": {
    "icon": "󰍃",
    "label": "Logout",
    "action": "niri msg action quit"
  },
  "system.reboot": {
    "icon": "󰜉",
    "label": "Reboot",
    "action": "systemctl reboot"
  },
  "system.shutdown": {
    "icon": "󰐥",
    "label": "Shutdown",
    "action": "systemctl poweroff"
  },
  "system.hidden-apps": {
    "icon": "\udb80\ude09",
    "label": "Hidden apps",
    "aliases": ["hidden", "restore apps"],
    "provider": "hidden-apps"
  },
  "system.tray": {
    "icon": "\uf0c9",
    "label": "Tray icons",
    "aliases": ["tray", "hidden tray"],
    "provider": "hidden-tray"
  }
}
